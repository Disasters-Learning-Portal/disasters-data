      "datetime_range": "day",
      "id_regex": "^((?:Palisades|Eaton)_AV3_provisional_dNBR_866nm_2198nm_\\d{4}-\\d{2}-\\d{2}_\\d{4}-\\d{2}-\\d{2})_day\\.tif$",
      "id_template": "aviris3-dnbr-daily-{}",

{
  "collection": "blackmarble-hd-daily",
  "title": "Black Marble HD",
  "description": "Black Marble HD daily BRDF-corrected nighttime lights imagery, produced at high definition from VIIRS Day-Night Band observations. Nighttime lights are used in disaster response to locate power outages and to track the pace of restoration, by comparing post-event radiance against a pre-event baseline.\n\nThis collection covers the Suomi-NPP (VNP46A2) platform only. The NOAA-20 (VJ146A2) variant shares this same S3 prefix and is a separate collection, so the discovery regex excludes any name carrying the noaa20 token -- without that exclusion both collections would match the same files and every Black Marble object would become an ambiguous match that discovery skips.",
  "license": "CC0-1.0",
  "stac_version": "1.0.0",
  "dashboard:is_periodic": false,
  "dashboard:time_density": "day",
  "dashboard:time_interval": "P1D",
  "links": [],
  "spatial_extent": {
    "xmin": -180,
    "ymin": -90,
    "xmax": 180,
    "ymax": 90
  },
  "temporal_extent": {
    "startdate": "2020-01-01T00:00:00Z",
    "enddate": null
  },
  "discovery_items": [
    {
      "discovery": "s3",
      "prefix": "ProgramData/Blackmarble/hd/",
      "bucket": "nasa-disasters-staging",
      "filename_regex": "^(?!.*noaa20).*_day\\.tif$",
      "datetime_range": "day",
      "id_regex": ".*(\\d{4}-\\d{2}-\\d{2})_day\\.tif$",
      "id_template": "blackmarble-hd-daily-{}",
      "disasters:extract_event_name": true,
      "disasters:monty": true,
      "disasters:add_product": true,
      "disasters:add_providers": true,
      "cogify": false,
      "dry_run": false,
      "assets": {
        "blackmarble_hd": {
          "title": "Black Marble HD",
          "description": "Black Marble HD daily BRDF-corrected nighttime lights imagery.",
          "regex": "^(?!.*noaa20).*_day\\.tif$"
        }
      },
      "use_multithreading": false,
      "collection": "blackmarble-hd-daily"
    }
  ],
  "data_type": "cog",
  "stac_extensions": [
    "https://stac-extensions.github.io/render/v1.0.0/schema.json",
    "https://stac-extensions.github.io/item-assets/v1.0.0/schema.json"
  ],
  "item_assets": {
    "blackmarble_hd": {
      "type": "image/tiff; application=geotiff; profile=cloud-optimized",
      "roles": [
        "data",
        "layer"
      ],
      "title": "Black Marble HD",
      "description": "Black Marble HD daily BRDF-corrected nighttime lights imagery."
    }
  },
  "renders": {
    "dashboard": {
      "assets": [
        "blackmarble_hd"
      ],
      "bidx": [
        1,
        2,
        3
      ],
      "nodata": 0,
      "rescale": [
        [
          0,
          255
        ]
      ]
    },
    "blackmarble_hd": {
      "assets": [
        "blackmarble_hd"
      ],
      "bidx": [
        1,
        2,
        3
      ],
      "nodata": 0,
      "rescale": [
        [
          0,
          255
        ]
      ]
    }
  },
  "providers": [
    {
      "name": "NASA Black Marble",
      "roles": [
        "producer"
      ],
      "url": "https://blackmarble.gsfc.nasa.gov/"
    },
    {
      "name": "NASA Disasters Program",
      "roles": [
        "host"
      ],
      "url": "https://disasters.openveda.cloud"
    }
  ]
}
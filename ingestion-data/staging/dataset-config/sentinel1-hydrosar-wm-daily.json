        ],
        "3": [
          56,
          168,
          1
        ],
        "4": [
          230,
          151,
          2
        ]
      }
    }
  },
  "providers": [
    {
      "name": "NASA VEDA",
      "roles": [
        "host"
      ],
      "url": "https://www.earthdata.nasa.gov/dashboard/"
    }
  ],
  "item_assets": {
    "wm": {
      "type": "image/tiff; application=geotiff; profile=cloud-optimized",

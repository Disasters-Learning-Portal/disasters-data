          0
        ],
        "3": [
          56,
          168,
          1
        ],
        "4": [
          230,
          151,
          2
        ]
      }
    },
    "hydrosar-wm": {
      "assets": [
        "hydrosar-wm"
      ],
      "bidx": [
        1
      ],
      "nodata": 0,
      "resampling": "nearest",
      "colormap": {
        "1": [
          1,
          92,
          230
        ],
        "2": [
          255,
